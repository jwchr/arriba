{
  "name": "arriba",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Independent North Jersey to Manhattan NJ Transit bus commuter app. Not affiliated with NJ Transit.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gtfs": "node scripts/build-gtfs.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fflate": "0.8.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
