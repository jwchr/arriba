{
  "name": "arriba",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Independent North Jersey to Manhattan NJ Transit bus commuter app. Not affiliated with NJ Transit.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gtfs": "node scripts/build-gtfs.mjs",
    "timetable": "node scripts/build-timetable.mjs",
    "verify": "npm run check && npm test && npm run worker:check && npm run build:test && npm run test:e2e",
    "worker:check": "WRANGLER_SEND_METRICS=false node scripts/worker-fixture.mjs && WRANGLER_SEND_METRICS=false wrangler deploy --config worker/wrangler.jsonc --dry-run --outdir ../.wrangler/check",
    "worker:prepare": "node scripts/prepare-live-worker.mjs",
    "build:test": "node scripts/build-test-app.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "gtfs-realtime-bindings": "2.2.0",
    "maplibre-gl": "6.15.0",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fflate": "0.8.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.158.0"
  }
}
